        "view": {
          "permission": "view staff",
          "label": "View Staff",
          "label_key": "school.capabilities.staff.view",
          "action_type": "read",
          "default_roles": ["admin", "operator"],
          "oauth_scope": "staff:read"
        },
        "manage": {
          "permission": "manage staff",
          "label": "Manage Staff",
          "label_key": "school.capabilities.staff.manage",
          "action_type": "manage",
          "default_roles": ["admin"],
          "oauth_scope": "staff:write"
        }
      }
    },
    "discipline": {
