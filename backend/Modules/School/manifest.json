{
  "name": "School",
  "slug": "school",
  "version": "1.0.3",
  "description": "JA-EduSIS Core School Management System — Academic, Students, Staff, Attendance, Discipline, Administration, Facilities, and Student Affairs",
  "author": "Jejakawan Team",
  "type": "module",
  "family": "sis",
  "requires": {
    "php": ">=8.2",
    "laravel": ">=13.0",
    "core": ">=1.0.0"
  },
  "is_core": false,
  "license": "Commercial PRO",
  "license_tier": "pro",
  "settings_route": "school.settings",
  "features": [
    {
      "slug": "academic",
      "name": "Academic Management",
      "description": "Years, Semesters, Study Groups, Subjects, Timetables, and Teaching Journals",
      "category": "academic"
    },
    {
      "slug": "student",
      "name": "Student Affairs & Discipline",
      "description": "Dapodik Student Records, Credit Points, Violations, Achievements, and Counseling",
      "category": "student"
    },
    {
      "slug": "staff",
      "name": "Educators & Staff (GTK)",
      "description": "Staff master records, employee shifts, and teaching assignments",
      "category": "hr"
    },
    {
      "slug": "attendance",
      "name": "School Attendance",
      "description": "Daily Student and Staff Attendance tracking with QR and sick note verification",
      "category": "operations"
    },
    {
      "slug": "grades",
      "name": "Grading & Report Cards",
      "description": "Formative and summative grade management and Kurikulum Merdeka report cards",
      "category": "academic"
    },
    {
      "slug": "letters",
      "name": "Official Letters & Dispositions",
      "description": "Incoming/outgoing official correspondence and executive dispositions",
      "category": "operations"
    },
    {
      "slug": "ppdb",
      "name": "Student Admission (PPDB)",
      "description": "New student online application, document verification, and admission approval",
      "category": "operations"
    },
    {
      "slug": "facilities",
      "name": "Facilities & Logistics (Sarpras)",
      "description": "Room inventory, asset tracking, and maintenance repair tickets",
      "category": "facilities"
    },
    {
      "slug": "voting",
      "name": "Student Affairs & E-Voting Engine",
      "description": "OSIS/MPK elections, candidate nomination, voter tokens, and kiosk voting booths",
      "category": "student"
    },
    {
      "slug": "guest_book",
      "name": "Guest Book",
      "description": "Digital visitor logbook and check-in/check-out management",
      "category": "operations"
    },
    {
      "slug": "osis",
      "name": "OSIS & Extracurricular",
      "description": "Student organization elections and extracurricular activity management",
      "category": "student"
    },
    {
      "slug": "katampi",
      "name": "KataMPI CBT Engine Integration",
      "description": "Cross-cluster exam roster synchronization and automated grade ingestion",
      "category": "integration"
    },
    {
      "slug": "whatsapp",
      "name": "Parent Communication Gateway",
      "description": "Automated WhatsApp alerts for daily attendance and student discipline",
      "category": "integration"
    }
  ],
  "capabilities": {
    "academic": {
      "name": "Academic Master Data",
      "description": "Manage academic years, terms, classes, and subjects",
      "actions": {
        "view": {
          "permission": "view academic",
          "label": "View Academic Data",
          "label_key": "school.capabilities.academic.view",
          "action_type": "read",
          "default_roles": ["admin", "operator", "teacher"],
          "oauth_scope": "academic:read"
        },
        "manage": {
          "permission": "manage academic",
          "label": "Manage Academic Data",
          "label_key": "school.capabilities.academic.manage",
          "action_type": "manage",
          "default_roles": ["admin"],
          "oauth_scope": "academic:write"
        }
      }
    },
    "students": {
      "name": "Student Records",
      "description": "Manage student profiles and admissions",
      "actions": {
        "view": {
          "permission": "view students",
          "label": "View Students",
          "label_key": "school.capabilities.students.view",
          "action_type": "read",
          "default_roles": ["admin", "operator", "teacher"],
          "oauth_scope": "students:read"
        },
        "manage": {
          "permission": "manage students",
          "label": "Manage Students",
          "label_key": "school.capabilities.students.manage",
          "action_type": "manage",
          "default_roles": ["admin"],
          "oauth_scope": "students:write"
        }
      }
    },
    "staff": {
      "name": "Educators & GTK Staff",
