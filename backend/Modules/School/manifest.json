          "label_key": "school.capabilities.attendance.manage",
          "action_type": "manage",
          "default_roles": ["admin", "teacher"],
          "oauth_scope": "attendance:write"
        }
      }
    },
    "grades": {
      "name": "Grading & Report Cards",
